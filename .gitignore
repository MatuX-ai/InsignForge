.env
.env.local
.env.*.local
.env.production
.env.development
**/.env
!**/.env.example

# ---------- 运行时 / 数据库 ----------
data/*.db
data/*.db-journal
data/*.db-shm
data/*.db-wal
data/build.log
data/logs/
data/*.log
**/*.sqlite
**/*.sqlite-journal

# ---------- IDE / 编辑器 ----------
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

