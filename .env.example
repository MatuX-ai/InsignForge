# ============================================================
# InsightForge 个人版 - 环境变量配置
# 复制此文件为 .env 并填入真实值: cp .env.example .env
# ============================================================

# ---------- LLM (大语言模型) ----------
# 提供商: deepseek / openai / ollama
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
# 仅在选择对应提供商时填入
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
# Ollama 本地模型地址(可选)
OLLAMA_BASE_URL=http://localhost:11434

# ---------- 搜索引擎 ----------
# 提供商: openserp / serpapi
SEARCH_PROVIDER=openserp
OPENSERP_URL=http://localhost:8080
SERPAPI_KEY=

# ---------- 数据库 ----------
# SQLite 单文件存储,路径相对于 backend/ 目录
DATABASE_URL=../data/insightforge.db

# ---------- 服务端口 ----------
FRONTEND_PORT=3000
BACKEND_PORT=3001
WORKFLOW_PORT=5678
OPENSERP_PORT=8080

# ---------- 可选高级配置 ----------
# Hermes Agent 启用(MVP 阶段未使用,预留)
HERMES_ENABLED=false

# 日志级别: debug / info / warn / error
LOG_LEVEL=info

# 调研超时(秒),超过则标记为失败
RESEARCH_TIMEOUT=300