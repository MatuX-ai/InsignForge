# ============================================================
# InsightForge 个人版 - 环境变量配置
# 复制此文件为 .env 并填入真实值: cp .env.example .env
# ============================================================

# ---------- LLM (大语言模型) ----------
# 提供商(参见 frontend/src/lib/llmProviders.ts):
#   国产(8 家):deepseek / zhipu(智谱 GLM) / qwen(通义千问) / moonshot(Kimi) / yi(零一万物)
#              / MiniMax(MiniMax) / hunyuan(腾讯混元) / sensenova(商汤日日新) / stepfun(阶跃星辰)
#   国际/本地:openai / ollama
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
# ---------- 国际 / 本地 Provider Key ----------
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
# Ollama 本地模型地址(可选)
OLLAMA_BASE_URL=http://localhost:11434
# ---------- 国产大模型 API Key(OpenAI 兼容协议) ----------
# 智谱 BigModel(GLM-4 系列)  https://bigmodel.cn/usercenter/proj-key
ZHIPU_API_KEY=
# 通义千问 Qwen DashScope    https://dashscope.console.aliyun.com/apiKey
QWEN_API_KEY=
# 月之暗面 Kimi                https://platform.moonshot.cn/console/api-keys
MOONSHOT_API_KEY=
# 零一万物 Yi                  https://platform.lingyiwanwu.com/apikeys
YI_API_KEY=
# MiniMax MiniMax               https://platform.MiniMax.io/user-center/basic-information/interface-key
MINIMAX_API_KEY=
# 腾讯混元                     https://console.cloud.tencent.com/hunyuan/api-key
HUNYUAN_API_KEY=
# 商汤日日新                   https://platform.sensenova.cn/docManage
SENSENOVA_API_KEY=
# 阶跃星辰                     https://platform.stepfun.ai/
STEPFUN_API_KEY=

# ---------- 搜索引擎 ----------
# 免配置冷启动: 不填任何搜索配置也能开箱即用(讨论调研使用内置示例数据兜底)。
# 需要更精准的实时市场数据时,二选一:
#   - SerpAPI: SEARCH_PROVIDER=serpapi 并填入 SERPAPI_KEY(自行在 https://serpapi.com 申请)
#   - OpenSerp: 自托管服务后设置 OPENSERP_URL(默认 http://localhost:8080)
# 也支持在「设置」页界面配置,保存后立即生效并持久化到 .env。
SEARCH_PROVIDER=openserp
OPENSERP_URL=http://localhost:8080
SERPAPI_KEY=

# ---------- 讨论 AI 调研的 MCP 通道(可选) ----------
# 配置后,讨论梳理中的营销调研优先走 MCP server(如 @insightforge/mcp-server);
# 未配置则后端直连搜索源;两者都不可用时回退内置示例数据(免配置冷启动)。
# INSIGHTFORGE_MCP_COMMAND=npx -y @insightforge/mcp-server

# ---------- 数据库 ----------
# SQLite 单文件存储,路径相对于 backend/ 目录
DATABASE_URL=../data/insightforge.db

# ---------- 服务端口 ----------
FRONTEND_PORT=3000
BACKEND_PORT=3001
WORKFLOW_PORT=5678
OPENSERP_PORT=8080

# ---------- 可选高级配置 ----------
# Hermes Agent 启用(MVP 阶段未使用,预留)
HERMES_ENABLED=false

# 日志级别: debug / info / warn / error
LOG_LEVEL=info

# 调研超时(秒),超过则标记为失败
RESEARCH_TIMEOUT=300