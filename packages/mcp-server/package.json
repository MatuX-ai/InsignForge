{
  "name": "@insightforge/mcp-server",
  "version": "0.1.1",
  "description": "InsightForge MCP(Model Context Protocol)服务器 —— 暴露 4 个市场调研工具给 Claude Desktop / Cline / Cursor 等 MCP 客户端。基于 @insightforge/core SDK。",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "insightforge-mcp": "./bin/insightforge-mcp.mjs"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:types": "tsc -p tsconfig.types.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist .tsbuildinfo",
    "verify": "node scripts/verify-bundle.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "start": "node bin/insightforge-mcp.mjs",
    "start:stdio": "node bin/insightforge-mcp.mjs --transport stdio",
    "start:http": "node bin/insightforge-mcp.mjs --transport http --port 3002"
  },
  "keywords": [
    "insightforge",
    "mcp",
    "model-context-protocol",
    "market-research",
    "ai-agent",
    "claude-desktop",
    "cline",
    "cursor"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@insightforge/core": "file:../core",
    "@modelcontextprotocol/sdk": "^1.20.0",
    "express": "^4.21.0",
    "pino": "^9.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.0",
    "esbuild": "^0.28.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}